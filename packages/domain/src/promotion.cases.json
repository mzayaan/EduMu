{
  "_comment": [
    "Shared parity fixture for the promotion engine.",
    "",
    "Read by packages/domain/src/promotion.parity.test.ts (TypeScript side) and",
    "compiled into supabase/tests/_generated_promotion_parity.sql by",
    "scripts/gen-promotion-parity.mjs (Postgres side).",
    "",
    "One file so the two implementations cannot drift: if you add a case here,",
    "regenerate with `npm run gen:promotion-parity` and both sides pick it up.",
    "Editing only the SQL or only the test defeats the point."
  ],
  "cases": [
    {
      "name": "clear pass promotes",
      "facts": { "aggregate": 55, "grade": 8 },
      "expect": "promote"
    },
    {
      "name": "boundary aggregate is inclusive",
      "facts": { "aggregate": 40, "grade": 8 },
      "expect": "promote"
    },
    {
      "name": "just under the boundary does not promote",
      "facts": { "aggregate": 39.99, "grade": 8, "times_repeated": 3 },
      "expect": "repeat"
    },
    {
      "name": "second-attempt relief for a near miss who attended",
      "facts": { "aggregate": 37, "grade": 8, "times_repeated": 1, "attendance_pct_incl_authorised": 80 },
      "expect": "conditional_promote"
    },
    {
      "name": "no relief after two repeats",
      "facts": { "aggregate": 37, "grade": 8, "times_repeated": 2, "attendance_pct_incl_authorised": 95 },
      "expect": "repeat"
    },
    {
      "name": "no relief on poor attendance",
      "facts": { "aggregate": 38, "grade": 8, "times_repeated": 0, "attendance_pct_incl_authorised": 60 },
      "expect": "repeat"
    },
    {
      "name": "a pupil with no marks does not promote on a null aggregate",
      "facts": { "aggregate": null, "grade": 8, "times_repeated": 0, "attendance_pct_incl_authorised": 99 },
      "expect": "repeat"
    },
    {
      "name": "Lower VI entry on four credits",
      "facts": { "grade": 11, "credit_count": 4 },
      "expect": "promote"
    },
    {
      "name": "three credits with age relief goes up conditionally",
      "facts": { "grade": 11, "credit_count": 3, "times_repeated": 1, "age_at_jan_1": 18 },
      "expect": "conditional_promote"
    },
    {
      "name": "three credits, already repeated, too old — leaves after SC",
      "facts": { "grade": 11, "credit_count": 3, "times_repeated": 2, "age_at_jan_1": 21 },
      "expect": "leave"
    },
    {
      "name": "two credits, never repeated — repeats Form V",
      "facts": { "grade": 11, "credit_count": 2, "times_repeated": 0 },
      "expect": "repeat"
    },
    {
      "name": "Upper VI entry on two Principal and two Subsidiary",
      "facts": { "grade": 12, "pass_count_principal": 2, "pass_count_subsidiary": 2 },
      "expect": "promote"
    },
    {
      "name": "three Principal but one Subsidiary is not enough",
      "facts": { "grade": 12, "pass_count_principal": 3, "pass_count_subsidiary": 1, "times_repeated": 0 },
      "expect": "repeat"
    },
    {
      "name": "cannot qualify and cannot repeat — referred, not failed",
      "facts": { "grade": 12, "pass_count_principal": 0, "pass_count_subsidiary": 0, "times_repeated": 1 },
      "expect": "refer"
    },
    {
      "name": "Upper VI completes school; the outcome is leaving",
      "facts": { "grade": 13, "aggregate": 80 },
      "expect": "leave"
    },
    {
      "name": "a grade with no rules at all falls through to repeat",
      "facts": { "grade": 6, "aggregate": 99 },
      "expect": "repeat"
    }
  ],
  "factDefaults": {
    "aggregate": null,
    "credit_count": 0,
    "pass_count": 0,
    "pass_count_principal": 0,
    "pass_count_subsidiary": 0,
    "attendance_pct": 90,
    "attendance_pct_incl_authorised": 95,
    "times_repeated": 0,
    "age_at_jan_1": 15,
    "has_medical_certificate_for_prolonged_absence": false,
    "core_passed": {},
    "grade": 8,
    "stream": null
  }
}
