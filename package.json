{
  "name": "edumu",
  "private": true,
  "version": "0.1.0",
  "description": "EduMU — School Management System for Mauritian secondary schools",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @edumu/web",
    "build": "npm run build -w @edumu/web",
    "preview": "npm run preview -w @edumu/web",
    "typecheck": "tsc -b apps/web",
    "test": "vitest run",
    "db:pull": "supabase db pull",
    "db:types": "supabase gen types typescript --project-id wdwtapdmdgdcvbifbeiz > apps/web/src/types/database.ts",
    "test:sql": "node scripts/run-sql-tests.mjs",
    "gen:parity": "node scripts/gen-parity-sql.mjs",
    "bench:timetable": "node --experimental-strip-types scripts/bench-timetable.ts",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "pg": "^8.13.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "vite": "^6.4.3"
  },
  "type": "module"
}
